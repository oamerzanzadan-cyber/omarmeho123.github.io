            <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto animate-fadeIn">
                اكتشف أسرار شخصيتك، نقاط قوتك وضعفك، والوظائف المناسبة لك حسب برجك الفلكي
            </p>
            <div class="flex items-center justify-center gap-2 text-white/80">
                <i class="fas fa-mouse-pointer"></i>
                <span>اختر برجك للحصول على تحليل شامل</span>
            </div>
        </div>
    </section>

    <!-- Zodiac Cards Grid -->
